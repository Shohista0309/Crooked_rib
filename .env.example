# Database Connection
# For local zero-dependency development (SQLite):
DATABASE_URL="file:./dev.db"

# For PostgreSQL production deployment (e.g. Supabase, Neon, AWS RDS, local PG):
# DATABASE_URL="postgresql://crooked_user:secure_password@localhost:5432/crooked_rib?schema=public"

# Authentication Secret
AUTH_SECRET="crooked-rib-secure-jwt-and-cookie-secret-key-32-chars-minimum-fashiontech"

# Optional External AI API (OpenAI, Gemini, or compatible proxy)
# If not set, system cleanly informs user that API key is needed and allows sketch upload / manual input
AI_API_KEY=""
AI_API_URL="https://api.openai.com/v1/chat/completions"
AI_MODEL="gpt-4o"

# Environment
NODE_ENV="development"
PORT=3000
